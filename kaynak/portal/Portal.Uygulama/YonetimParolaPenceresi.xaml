<Window x:Class="Portal.Uygulama.YonetimParolaPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource PortalDiyalog}"
        Title="Yönetim Parolası"
        Width="400" Height="210"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Parolayı bir kez girin. Sarnıç kapanana kadar yeniden sorulmaz."
                   FontSize="13" Foreground="{DynamicResource MetinFircasi}" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <PasswordBox x:Name="ParolaKutusu" Grid.Row="1" Padding="8,6" FontSize="14"/>
        <DockPanel Grid.Row="3" LastChildFill="False">
            <Button Style="{StaticResource BirincilDugme}" Content="Tamam" DockPanel.Dock="Right"
                    Padding="16,6" Margin="8,0,0,0" IsDefault="True" Click="Tamam_Click"/>
            <Button Content="İptal" DockPanel.Dock="Right" Padding="16,6" IsCancel="True"/>
        </DockPanel>
    </Grid>
</Window>
