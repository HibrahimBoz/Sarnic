<Window x:Class="Portal.Uygulama.AjanPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource PortalPencere}"
        Title="Sarnıç — Ajana Sor"
        Width="1100" Height="680" MinWidth="820" MinHeight="460"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="DurumMetni" Grid.Row="0" Text="Atölye servisine bağlanılıyor..."
                   Foreground="{DynamicResource SolukMetinFircasi}" Margin="0,0,0,10" TextWrapping="Wrap"/>

        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <Button x:Name="SorDugmesi" DockPanel.Dock="Right" Content="Sor" Padding="22,6" Margin="8,0,0,0"
                    Style="{StaticResource BirincilDugme}" Click="Sor_Click"/>
            <TextBox x:Name="SoruKutusu" Padding="6,5" MaxLength="2000" TextWrapping="Wrap" AcceptsReturn="False"
                     KeyDown="SoruKutusu_KeyDown"/>
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="SoruListesi" Grid.Column="0" Background="{DynamicResource YuzeyFircasi}"
                     Foreground="{DynamicResource MetinFircasi}" BorderBrush="{DynamicResource KenarlikFircasi}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="SoruListesi_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <TextBlock Text="{Binding Soru}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding DurumMetni}" Foreground="{DynamicResource SolukMetinFircasi}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="150"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="CevapKutusu" Grid.Row="0" IsReadOnly="True" TextWrapping="Wrap" Padding="10" VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto" Background="{DynamicResource YuzeyFircasi}"
                         Foreground="{DynamicResource MetinFircasi}" BorderBrush="{DynamicResource KenarlikFircasi}"/>
                <TextBlock Grid.Row="1" Text="Kaynaklar (çift tıklayın: dosyayı klasörde gösterir)" Margin="0,8,0,4"
                           Foreground="{DynamicResource SolukMetinFircasi}"/>
                <ListBox x:Name="KaynakListesi" Grid.Row="2" Background="{DynamicResource YuzeyFircasi}"
                         Foreground="{DynamicResource MetinFircasi}" BorderBrush="{DynamicResource KenarlikFircasi}"
                         MouseDoubleClick="KaynakListesi_MouseDoubleClick"/>
            </Grid>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="False">
            <Button x:Name="IptalDugmesi" Content="Seçili soruyu iptal et" Padding="14,6" IsEnabled="False" Click="Iptal_Click"/>
            <TextBlock x:Name="SonucMetni" Margin="14,0" VerticalAlignment="Center" Foreground="{DynamicResource SolukMetinFircasi}"/>
        </DockPanel>
    </Grid>
</Window>
