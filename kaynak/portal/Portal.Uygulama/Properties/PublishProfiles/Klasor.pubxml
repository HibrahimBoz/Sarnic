<?xml version="1.0" encoding="utf-8"?>
<!-- Klasör yayın profili (Video Portalı): self-contained, win-x64, libvlc yanında gelir. Kullanım: paketle-portal.ps1 -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <!-- "Any CPU" (boşluklu) libvlc NuGet hedefini devre dışı bırakır; "AnyCPU" yazılmalı. -->
    <Platform>AnyCPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\..\dist\VideoPortali\</PublishDir>
  </PropertyGroup>
</Project>
