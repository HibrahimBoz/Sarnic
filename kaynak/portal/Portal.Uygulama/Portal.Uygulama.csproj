<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Portal.Uygulama</AssemblyName>
    <RootNamespace>Portal.Uygulama</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Varliklar\uygulama.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp.WPF" Version="3.10.1" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Portal.Cekirdek\Portal.Cekirdek.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ayar.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Varliklar\logo-256.png;Varliklar\uygulama.ico" />
    <Resource Include="Varliklar\logo-256.png" />
    <Resource Include="Varliklar\uygulama.ico" />
  </ItemGroup>

  <!-- Yayında yalnız win-x64 libvlc kalır (ölçüldü: x86 105 MB + arm64 91 MB gereksiz). -->
  <Target Name="LibVlcFazlaMimariTemizle" AfterTargets="Publish">
    <RemoveDir Directories="$(PublishDir)libvlc\win-x86;$(PublishDir)libvlc\win-arm64" />
  </Target>

</Project>
